{
  "name": "vrm-electron",
  "productName": "Hikari",
  "version": "1.0.0",
  "description": "VRM Viewer - Electron + Vite Desktop App",
  "type": "module",
  "main": "electron/main.js",
  "config": {
    "forge": "./forge.config.cjs"
  },
  "scripts": {
    "dev": "vite --mode electron",
    "dev:web": "vite --mode web --open",
    "build": "node tools/build-media-state.mjs && node tools/build-voice-stt.mjs && node tools/build-music-beat.mjs && vite build --mode electron && copyfiles -u 1 electron/assets/loading.gif dist",
    "build:web": "vite build --mode web-local",
    "build:web:github": "vite build --mode web",
    "start": "npm run build && npx electron .",
    "start:web": "node tools/start-web.mjs",
    "serve:web": "node server/index.js",
    "package": "npm run build && node tools/build-mac-icon.mjs && npx electron-forge package",
    "make:dmg": "node tools/build-dmg.mjs",
    "make": "npm run build && node tools/build-mac-icon.mjs && npx electron-forge make"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.4.0",
    "@electron-forge/maker-deb": "^7.4.0",
    "@electron-forge/maker-rpm": "^7.4.0",
    "@electron-forge/maker-squirrel": "^7.4.0",
    "@electron-forge/maker-zip": "^7.4.0",
    "copyfiles": "^2.4.1",
    "electron": "^40.7.0",
    "vite": "^7.3.1",
    "vite-plugin-electron": "^0.28.0"
  },
  "dependencies": {
    "@pixiv/three-vrm": "^3.0.0",
    "@pixiv/three-vrm-animation": "^3.0.0",
    "get-windows": "^9.3.0",
    "three": "^0.176.0",
    "uiohook-napi": "^1.5.5"
  },
  "allowScripts": {
    "electron@40.7.0": true
  }
}
